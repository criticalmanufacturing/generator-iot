{
  "name": "@criticalmanufacturing/generator-iot",
  "version": "11.0.9",
  "description": "Connect IoT Scaffolding",
  "files": [
    "generators/*.js",
    "generators/*/*.js",
    "generators/**/*.js",
    "generators/*/templates/**"
  ],
  "keywords": [
    "CMF",
    "IoT",
    "yeoman-generator"
  ],
  "homepage": "https://github.com/criticalmanufacturing/generator-iot/tree/110x",
  "scripts": {
    "build": "tsc",
    "test": "mocha ./generators/packagePacker/test/*.test.js --timeout 30000 --exit",
    "test:coverage": "nyc -r cobertura -r lcov -r text-summary npm run test -R mocha-multi-reporters --reporter-options configFile=mocha-multi-reporters-config.json",
    "watch": "npm run watchPackage",
    "watchPackage": "tsc --preserveWatchOutput -w",
    "watchTests": "tsc -p ./generators/packagePacker/test --preserveWatchOutput -w",
    "lint": "eslint ./**/*.ts",
    "lint:fix": "eslint ./**/*.ts --fix",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/chai": "4.3.16",
    "@types/chai-as-promised": "7.1.2",
    "@types/chai-spies": "1.0.6",
    "@types/chalk": "2.2.0",
    "@types/fs-extra": "11.0.4",
    "@types/mocha": "10.0.7",
    "@types/node": "20.12.12",
    "@types/sinon": "^17.0.3",
    "@types/uuid": "9.0.8",
    "@types/yeoman-generator": "5.2.14",
    "@types/yosay": "2.0.3",
    "@typescript-eslint/eslint-plugin": "7.13.1",
    "@typescript-eslint/parser": "7.13.1",
    "chai-as-promised": "7.1.2",
    "sinon": "^19.0.2",
    "typescript": "5.2.2"
  },
  "dependencies": {
    "@swc/core": "^1.5.7",
    "@vercel/ncc": "0.38.1",
    "chai": "4.4.1",
    "chai-spies": "1.1.0",
    "chalk": "5.3.0",
    "eslint": "^8.53.0",
    "eslint-plugin-mocha": "10.4.3",
    "fs-extra": "11.2.0",
    "inversify": "6.0.2",
    "mocha": "10.4.0",
    "mocha-junit-reporter": "2.2.1",
    "mocha-lcov-reporter": "1.3.0",
    "mocha-multi-reporters": "1.5.1",
    "nyc": "17.0.0",
    "punycode": "^2.3.1",
    "reflect-metadata": "0.2.2",
    "svgtofont": "^4.2.0",
    "uuid": "9.0.1",
    "yeoman-generator": "5.8.0",
    "yo": "4.3.1",
    "yosay": "2.0.2"
  },
